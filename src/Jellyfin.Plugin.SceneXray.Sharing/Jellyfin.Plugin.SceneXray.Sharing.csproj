<Project Sdk="Microsoft.NET.Sdk">

  <!-- Formats and algorithms shared by the plugin and (later) the sharing server, so the two can
       never disagree: contribution DTO, title keys, audio anchors, fingerprint matching and the
       alignment fit. No Jellyfin dependency. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.SceneXray.Sharing</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.SceneXray.Tests" />
  </ItemGroup>

</Project>
